# Marca de este despliegue (carpeta en src/tenants/ y fila en la tabla tenants)
TENANT=squish
# Muestra el selector de paletas de la demo
NEXT_PUBLIC_DEMO=1

# Supabase (Project Settings › API). Sin estas dos variables la tienda usa los JSON del repo (modo demo).
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Instagram (solo en el servidor; ver docs/INSTAGRAM.md) ──
# Clave secreta de Supabase (Project Settings › API Keys › Secret). Nunca con NEXT_PUBLIC_.
# También la usa el cobro con tarjeta (Culqi): las llaves de Culqi de cada marca se cargan en Admin › Ajustes, no aquí.
SUPABASE_SECRET_KEY=sb_secret_...
# App de Meta › Configuración de la app › Básica (ID de la app y clave secreta)
META_APP_ID=
META_APP_SECRET=
# Casos de uso › Instagram › API setup with Unified login › configuración creada
META_CONFIG_ID=
# Opcional: si no, se usa <dominio>/api/instagram/callback (debe estar registrada en la app de Meta)
# INSTAGRAM_REDIRECT_URI=https://demo.thesquishbox.com/api/instagram/callback
# Clave que protege /api/instagram/cron (Vercel Cron la manda sola)
CRON_SECRET=
# 1 = no llama a Meta: usa los posts de ejemplo de la marca para probar en local
# IG_MOCK=1

# ── Alertas de pedidos (solo en el servidor; ver docs/ALERTAS.md) ──
# Opcional: dominio de los links "Ver en el panel"
# SITE_URL=https://demo.thesquishbox.com
# Telegram: token del bot creado con @BotFather
TELEGRAM_BOT_TOKEN=
# Correo (Resend): clave con permiso de envío y remitente de un dominio verificado
RESEND_API_KEY=
ALERTS_FROM_EMAIL=
# WhatsApp Cloud API: token del usuario del sistema, ID del número y plantilla aprobada
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
